# AI RADAR — local environment template
# Copy to `.env` (never commit it; `.gitignore` already excludes it).
# The browser never reads this file — it is used only by Node scripts
# (scripts/pipeline/env.js): ingest.js, build-news.js.

# Browser-like identity sent with every feed request (some hosts block
# generic Node/axios user agents). Keep it descriptive and honest.
HTTP_USER_AGENT=Mozilla/5.0 (compatible; AIRadarBot/1.0; +https://krisna-19.github.io/AI_radar/)

# Per-request timeout for feed fetches, milliseconds.
FETCH_TIMEOUT_MS=15000

# How many feeds to fetch in parallel during ingestion.
INGEST_CONCURRENCY=4

# Stage 7 summarization -------------------------------
# Default 'extract' is deterministic and needs no credentials. Set to 'llm' to
# additionally try the optional LLM path (falls back to extractive on any
# failure / missing key). 'extract' always runs regardless.
SUMMARY_MODE=extract

# How many stories to summarize in parallel (LLM mode only; extractive ignores).
SUMMARY_CONCURRENCY=8

# Example of a secret the CI expects as a GitHub Action secret (encrypted).
# Do not put real values here — commit .env.example only.
# Used by the optional Stage 7 LLM summarization path (Node built-in fetch;
# no extra dependency). If unset, extraction is used.
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1